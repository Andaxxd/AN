<div class="announcement-bar">
  <div class="announcement-bar__inner">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {% else %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Barra de anuncios",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "NEW DROP LIVE ★ FREE WRISTBAND WITH EVERY ORDER ★ WORLDWIDE SHIPPING" },
    { "type": "url", "id": "link", "label": "Enlace (opcional)" }
  ]
}
{% endschema %}
