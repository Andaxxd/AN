<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__wordmark">Zaentra</span>
      <p>{{ section.settings.about_text }}</p>
      <div class="site-footer__social">
        {% if settings.social_instagram != blank %}
          <a href="https://instagram.com/{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
        {% endif %}
        {% if settings.social_tiktok != blank %}
          <a href="https://tiktok.com/@{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>
        {% endif %}
        {% if settings.social_facebook != blank %}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>
        {% endif %}
      </div>
    </div>

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'link_list' %}
          <div class="site-footer__column" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <ul>
              {% for link in linklists[block.settings.menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
      {% endcase %}
    {% endfor %}

    <div class="site-footer__newsletter">
      <h3>{{ section.settings.newsletter_heading }}</h3>
      <p>{{ section.settings.newsletter_text }}</p>
      {% form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__row">
          <label for="NewsletterEmail" class="visually-hidden">Email</label>
          <input type="email" id="NewsletterEmail" name="contact[email]" placeholder="tu@email.com" required>
          <button type="submit">Suscribirme</button>
        </div>
        {% if form.posted_successfully? %}
          <p class="newsletter-form__success">¡Gracias por suscribirte!</p>
        {% endif %}
        {% if form.errors %}
          <p class="newsletter-form__error">{{ form.errors.messages.email }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} Zaentra. Todos los derechos reservados.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "about_text", "label": "Texto de marca", "default": "Ropa y accesorios con actitud: camisetas de tirantes, fundas de móvil y joyería para ellos y ellas." },
    { "type": "text", "id": "newsletter_heading", "label": "Título newsletter", "default": "Únete al club Zaentra" },
    { "type": "text", "id": "newsletter_text", "label": "Texto newsletter", "default": "Sé el primero en enterarte de nuevos lanzamientos y ofertas." }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Tienda" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Tienda" } },
      { "type": "link_list", "settings": { "heading": "Ayuda" } }
    ]
  }
}
{% endschema %}
