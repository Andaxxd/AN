<div class="promo-banner">
  <div class="promo-banner__inner">
    <span class="promo-banner__icon" aria-hidden="true">🎁</span>
    <div class="promo-banner__content">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {% if section.settings.badge_text != blank %}
      <span class="promo-banner__badge">{{ section.settings.badge_text }}</span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Promo pulsera de regalo",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Free Zaentra wristband" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Every order ships with a free Zaentra fabric wristband — limited time only. Going for €1 once the intro run ends." },
    { "type": "text", "id": "badge_text", "label": "Texto de la insignia", "default": "FREE — FOR NOW" }
  ],
  "presets": [{ "name": "Promo pulsera de regalo" }]
}
{% endschema %}
