<div class="collection-list">
  <div class="collection-list__header">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="collection-list__grid">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      <a href="{% if collection %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="collection-card" {{ block.shopify_attributes }}>
        <div class="collection-card__media">
          {% if collection.featured_image %}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title }}" loading="lazy">
          {% else %}
            <span class="collection-card__emoji">{{ block.settings.emoji }}</span>
          {% endif %}
        </div>
        <h3>{{ block.settings.label }}</h3>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Categorías",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "label", "label": "Nombre a mostrar", "default": "Categoría" },
        { "type": "text", "id": "emoji", "label": "Emoji / icono", "default": "🛍️" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "label": "Tees", "emoji": "👕" } },
      { "type": "category", "settings": { "label": "Hoodies", "emoji": "🧥" } },
      { "type": "category", "settings": { "label": "Bottoms", "emoji": "👖" } },
      { "type": "category", "settings": { "label": "Accessories", "emoji": "⛓️" } }
    ]
  },
  "presets": [{ "name": "Categorías" }]
}
{% endschema %}
