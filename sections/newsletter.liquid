<div class="newsletter-section">
  <div class="newsletter-section__inner">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% form 'customer', id: 'NewsletterSection', class: 'newsletter-form newsletter-form--section' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__row">
        <label for="NewsletterSectionEmail" class="visually-hidden">Email</label>
        <input type="email" id="NewsletterSectionEmail" name="contact[email]" placeholder="tu@email.com" required>
        <button type="submit" class="button button--primary">{{ section.settings.button_label }}</button>
      </div>
      {% if form.posted_successfully? %}
        <p class="newsletter-form__success">You're in. Welcome to Zaentra.</p>
      {% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Join the movement" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Early access to drops, limited pieces and nothing else. No spam." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Join" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
