<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">{% endif %}

{{ content_for_header }}

{{ 'theme.css' | asset_url | stylesheet_tag }}

{% style %}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_header_font | font_face: font_display: 'swap' }}

  :root {
    --color-background: {{ settings.color_background | default: '#0A0A0B' }};
    --color-text: {{ settings.color_text | default: '#EAE6DC' }};
    --color-primary: {{ settings.color_primary | default: '#EAE6DC' }};
    --color-primary-text: {{ settings.color_primary_text | default: '#0C0C0D' }};
    --color-accent: {{ settings.color_accent | default: '#E23B2E' }};
    --color-success: {{ settings.color_success | default: '#E23B2E' }};
    --color-header-bg: {{ settings.color_header_bg | default: '#0A0A0B' }};
    --color-footer-bg: {{ settings.color_footer_bg | default: '#141416' }};
    --color-footer-text: {{ settings.color_footer_text | default: '#EAE6DC' }};
    --color-announcement-bg: {{ settings.color_announcement_bg | default: '#E23B2E' }};
    --color-announcement-text: {{ settings.color_announcement_text | default: '#120C0B' }};
    --font-header: {{ settings.type_header_font.family | default: 'Impact' }}, {{ settings.type_header_font.fallback_families | default: 'Arial Narrow Bold, sans-serif' }};
    --font-body: {{ settings.type_body_font.family | default: 'Helvetica Neue' }}, {{ settings.type_body_font.fallback_families | default: 'Helvetica, Arial, sans-serif' }};
  }
{% endstyle %}
</head>
<body>
  <a class="skip-to-content" href="#MainContent">Saltar al contenido</a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
