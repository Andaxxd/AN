<div class="error-404">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.text }}</p>
  <a href="{{ routes.root_url }}" class="button button--primary">{{ section.settings.button_label }}</a>
</div>

{% schema %}
{
  "name": "Página 404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Página no encontrada" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Lo sentimos, no pudimos encontrar esta página." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Volver al inicio" }
  ]
}
{% endschema %}
