<div class="product-card">
  <a href="{{ product.url }}" class="product-card__media">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
    {% else %}
      <span class="product-card__placeholder">{{ product.title | slice: 0 }}</span>
    {% endif %}
    {% if product.compare_at_price > product.price %}
      <span class="product-card__badge product-card__badge--sale">Oferta</span>
    {% endif %}
  </a>
  <div class="product-card__info">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'price', product: product %}
  </div>
  {% if product.selected_or_first_available_variant.available %}
    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="return_to" value="/cart">
      <button type="submit" class="button button--outline product-card__add">Añadir al carrito</button>
    </form>
  {% else %}
    <button class="button button--outline product-card__add" disabled>Agotado</button>
  {% endif %}
</div>
