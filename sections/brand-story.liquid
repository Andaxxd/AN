<div class="brand-story">
  <div class="brand-story__media">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading }}" loading="lazy">
    {% else %}
      <div class="brand-story__placeholder">Z</div>
    {% endif %}
  </div>
  <div class="brand-story__content">
    <h2>{{ section.settings.heading }}</h2>
    <div class="brand-story__text">{{ section.settings.text }}</div>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="button button--outline">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Historia de marca",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Not made for everyone" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Zaentra is a worldwide movement: heavyweight tees, hoodies, bottoms and hardware for the ones moving. Every order ships with the Zaentra fabric wristband — your entry to the club.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "The movement" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Historia de marca" }]
}
{% endschema %}
