<header class="site-header" data-header>
  <div class="site-header__inner">
    <button class="site-header__menu-toggle" data-menu-toggle aria-label="Abrir menú" aria-expanded="false">
      <span class="icon-menu">{% render 'icon-menu' %}</span>
      <span class="icon-close">{% render 'icon-close' %}</span>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if settings.logo %}
        <img
          src="{{ settings.logo | image_url: width: settings.logo_width }}"
          srcset="{{ settings.logo | image_url: width: settings.logo_width }} 1x, {{ settings.logo | image_url: width: settings.logo_width | times: 2 }} 2x"
          alt="{{ shop.name }}"
          width="{{ settings.logo_width }}"
          loading="eager">
      {% else %}
        <span class="site-header__wordmark">Zaentra</span>
      {% endif %}
    </a>

    <nav class="site-header__nav" data-nav>
      <ul>
        {% for link in linklists[section.settings.menu].links %}
          <li>
            <a href="{{ link.url }}"{% if link.active %} class="is-active"{% endif %}>{{ link.title }}</a>
            {% if link.links != blank %}
              <ul class="site-header__submenu">
                {% for childlink in link.links %}
                  <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="site-header__icons">
      <a href="{{ routes.search_url }}" aria-label="Buscar" class="site-header__icon">
        {% render 'icon-search' %}
      </a>
      <a href="{{ routes.account_url }}" aria-label="Cuenta" class="site-header__icon">
        {% render 'icon-account' %}
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Carrito" class="site-header__icon site-header__icon--cart">
        {% render 'icon-cart' %}
        {% if cart.item_count > 0 %}
          <span class="site-header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" }
  ]
}
{% endschema %}
